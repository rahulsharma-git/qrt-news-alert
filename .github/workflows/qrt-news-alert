name: QRT - 15 minute news alert
on:
  schedule:
    # UTC: 02,17,32,47 -> IST: 32,47,02,17. Avoid the top of each hour.
    - cron: '2,17,32,47 * * * *'
  workflow_dispatch:
    inputs:
      dry_run:
        description: 'Preview only (no email, no state changes)'
        type: boolean
        default: true
permissions:
  contents: write
concurrency:
  group: qrt-news-alert
  cancel-in-progress: false
jobs:
  scan:
    if: github.ref_name == github.event.repository.default_branch
    runs-on: ubuntu-latest
    timeout-minutes: 12
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.repository.default_branch }}
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: pip
      - name: Install lightweight dependencies
        run: python -m pip install -r requirements.txt
      - name: Scan and send new alerts
        id: scan
        env:
          SMTP_EMAIL: ${{ secrets.SMTP_EMAIL }}
          SMTP_APP_PASSWORD: ${{ secrets.SMTP_APP_PASSWORD }}
          ALERT_RECIPIENTS: ${{ secrets.ALERT_RECIPIENTS }}
          REPORT_RECIPIENTS: ${{ secrets.REPORT_RECIPIENTS }}
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          GROQ_MODEL: ${{ vars.GROQ_MODEL }}
          DRY_RUN: ${{ github.event_name == 'workflow_dispatch' && inputs.dry_run }}
        run: |
          if [ "$DRY_RUN" = "true" ]; then
            python -u monitor.py --dry-run
          else
            python -u monitor.py
          fi
      - name: Persist alert history
        if: steps.scan.outcome == 'success' && !(github.event_name == 'workflow_dispatch' && inputs.dry_run)
        run: |
          git add state/alert_history.json
          if git diff --cached --quiet; then exit 0; fi
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git commit -m 'chore: persist QRT alert history'
          git pull --rebase
          git push
      - name: Scan diagnostics
        if: always()
        run: |
          if [ -f scan_summary.json ]; then
            echo '### QRT scan diagnostics' >> "$GITHUB_STEP_SUMMARY"
            echo '```json' >> "$GITHUB_STEP_SUMMARY"
            cat scan_summary.json >> "$GITHUB_STEP_SUMMARY"
            echo '' >> "$GITHUB_STEP_SUMMARY"
            echo '```' >> "$GITHUB_STEP_SUMMARY"
          fi
          if [ -f preview.txt ]; then
            echo '### Dry-run email preview' >> "$GITHUB_STEP_SUMMARY"
            echo '```text' >> "$GITHUB_STEP_SUMMARY"
            cat preview.txt >> "$GITHUB_STEP_SUMMARY"
            echo '' >> "$GITHUB_STEP_SUMMARY"
            echo '```' >> "$GITHUB_STEP_SUMMARY"
          fi
